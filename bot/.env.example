# انسخ هذا الملف باسم .env واملأ القيم. لا ترفع .env إلى أي مكان عام.

# من @BotFather
TELEGRAM_TOKEN=

# معرّفاتك الرقمية ومعرّفات فريقك من @userinfobot — مفصولة بفاصلة
ALLOWED_IDS=

# قاعدة البيانات: Supabase Postgres عبر الـ pooler.
# المضيف المباشر db.<ref>.supabase.co لا يُحلّ على IPv4 في المشاريع الجديدة.
# رمّز كلمة المرور: @ ⇒ %40 · # ⇒ %23 · $ ⇒ %24
DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ووردبريس — مستخدم مخصص بصلاحية محرر + كلمة مرور تطبيق
WP_URL=https://alarabtravelers.com
WP_USER=
WP_APP_PASSWORD=

# العملة الأساسية للتكاليف
BASE_CURRENCY=USD

# رقم واتساب الشركة بالصيغة الدولية بلا +
WHATSAPP_NUMBER=966534436932

# ── الهوية التي تظهر للزبون في كل PDF وصورة ──
# ما يُترك فارغاً لا يُطبع أصلاً — لا تُخترع أرقام تراخيص ولا عناوين.
BRAND_LEGAL_NAME=
BRAND_LICENSE=
BRAND_ADDRESS=
BRAND_EMAIL=
# اتركها فارغة لتُستعمل القيم الافتراضية
BRAND_NAME=
BRAND_TAGLINE=
BRAND_SITE=
BRAND_LOGO=

# مسار المتصفح لتوليد PDF والصور.
# اتركه فارغاً على ويندوز — يُكتشف Chrome أو Edge تلقائياً.
PUPPETEER_EXECUTABLE_PATH=

# بديل: متصفح بعيد عبر WebSocket، للبيئات التي لا متصفح فيها
# (Supabase Edge Functions). مثال: wss://chrome.browserless.io?token=...
# حين يُملأ هذا يُتجاهل PUPPETEER_EXECUTABLE_PATH.
BROWSER_WS_ENDPOINT=
